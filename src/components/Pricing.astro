---
import { PRICING } from '../data/site';
import SectionBadge from './SectionBadge.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="pricing" class="relative flex w-full flex-col items-start overflow-clip bg-page px-0">
  <div class="relative mx-auto flex w-full max-w-none flex-col items-center gap-10 border-x border-line px-4 py-16 sm:px-8 lg:px-16 lg:py-20">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-page"></div>
      <img alt="" class="absolute size-full max-w-none object-cover opacity-20" src="/images/why-us-bg.png" />
    </div>
    <div class="pointer-events-none absolute top-[399px] left-[-1px] h-[557px] w-full opacity-24 mix-blend-difference lg:w-full">
      <div class="absolute inset-0 overflow-hidden">
        <img alt="" class="absolute top-[-3.51%] left-[-11.05%] h-[117.32%] w-[126.43%] max-w-none" src="/images/bg-texture.png" />
      </div>
    </div>

    <div class="relative flex w-full flex-col items-center gap-10">
      <SectionBadge label={PRICING.badge} />
      <SectionHeading title={PRICING.title} subtitle={PRICING.subtitle} />
    </div>

    <div class="relative flex w-full flex-col items-center gap-6 lg:w-full lg:max-w-[1400px] lg:flex-row lg:items-stretch lg:gap-10">
      {
        PRICING.plans.map((plan) => (
          <div class="flex w-full max-w-[354px] flex-col items-start border border-surface-2 bg-surface p-6 lg:h-[442px] lg:w-auto lg:max-w-none lg:flex-1">
            <div class="flex w-full flex-col items-start gap-4">
              <div class="flex flex-col items-start gap-1">
                <p class="font-geist text-xl leading-[30px] font-semibold whitespace-nowrap text-strong">{plan.name}</p>
                <div class="flex items-center justify-center gap-4">
                  <p class="font-mono text-base leading-[30px] whitespace-nowrap text-muted">{plan.price}</p>
                  <span class="flex items-center justify-center rounded border border-azure-51 bg-linear-to-b from-azure-51 to-azure-64 px-4 py-1">
                    <span class="font-mono text-xs leading-[18px] whitespace-nowrap text-strong">{plan.tag}</span>
                  </span>
                </div>
              </div>
              <ul class="flex flex-col items-start gap-2">
                {plan.features.map((f) => (
                  <li class="flex w-full items-center gap-2.5">
                    <Icon name={f.icon} />
                    <span class="font-geist text-xs leading-6 whitespace-nowrap text-strong">{f.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
