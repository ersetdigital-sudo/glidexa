---
// Hugeicons used in the pricing cards, rebuilt from the Figma vector layers.
import type { IconName } from '../data/site';

interface Props {
  name?: IconName;
  class?: string;
}

const { name = 'clock-01', class: className = '' } = Astro.props;

type Layer = { box: string; pad: string; src: string };

const L = (box: string, pad: string, file: string): Layer => ({ box, pad, src: `/images/icons/${file}.svg` });

const ICONS: Record<Exclude<IconName, 'ai-magic'>, Layer[]> = {
  'clock-01': [
    L('inset-[8.33%]', 'inset-[-4.29%]', 'v0'),
    L('bottom-[41.67%] left-1/2 right-[41.67%] top-[33.33%]', 'inset-[-14.29%_-42.86%]', 'v1'),
  ],
  'customer-support': [
    L('inset-[37.5%_8.33%_29.17%_8.33%]', 'inset-[-10.71%_-4.29%]', 'v2'),
    L('inset-[12.5%_20.83%_62.5%_20.83%]', 'inset-[-14.29%_-6.12%]', 'v3'),
    L('inset-[70.83%_20.83%_12.5%_54.17%]', 'inset-[-21.43%_-14.29%]', 'v4'),
  ],
  'lock-keyhole': [
    L('inset-[8.33%_31.27%_62.5%_31.23%]', 'inset-[-12.24%_-9.52%]', 'v5'),
    L('inset-[37.5%_16.68%_8.33%_16.65%]', 'inset-[-6.59%_-5.36%]', 'v6'),
    L('inset-[56.25%_41.68%_27.08%_41.65%]', 'inset-[-21.43%]', 'v7'),
  ],
  'ticket-star': [
    L('inset-[14.58%_27.08%_14.58%_33.33%]', 'inset-[-5.04%_-9.04%_-5.04%_-9.02%]', 'v8'),
    L('inset-[14.58%_8.33%]', 'inset-[-5.04%_-4.29%]', 'v9'),
  ],
  marketing: [
    L('bottom-1/4 left-[58.33%] right-[8.33%] top-[8.33%]', 'inset-[-5.36%_-10.71%]', 'v10'),
    L('bottom-1/4 left-[8.33%] right-1/4 top-[8.33%]', 'inset-[-5.36%_0_-5.36%_-5.36%]', 'v11'),
    L('inset-[62.5%_54.17%_8.33%_24.99%]', 'inset-[-12.25%_-17.14%]', 'v12'),
  ],
  'globe-02': [
    L('inset-[8.33%]', 'inset-[-4.29%]', 'v0'),
    L('inset-[8.33%_33.33%]', 'inset-[-4.29%_-10.71%]', 'v13'),
    L('inset-[37.5%_12.5%]', 'inset-[-14.29%_-4.76%]', 'v14'),
  ],
  'task-01': [
    L('inset-[8.33%_33.35%_37.5%_33.32%]', 'inset-[-6.59%_-10.71%]', 'v15'),
    L('inset-[14.58%_16.68%_8.33%_16.65%]', 'inset-[-4.63%_-5.36%]', 'v16'),
  ],
  'monitor-smartphone': [
    L('inset-[79.17%_52.12%_20.83%_31.22%]', 'inset-[-0.5px_-21.43%]', 'v17'),
    L('inset-[62.5%_58.37%_20.83%_41.63%]', 'inset-[0_-0.5px]', 'v18'),
    L('bottom-[45.83%] left-[72.88%] right-[18.78%] top-1/2', 'inset-[-85.71%_-42.86%]', 'v19'),
    L('bottom-[8.33%] left-[62.47%] right-[8.37%] top-1/2', 'inset-[-8.57%_-12.24%]', 'v20'),
    L('inset-[8.33%_12.53%_37.5%_8.3%]', 'inset-[-6.59%_-4.51%]', 'v21'),
  ],
};

const size = name === 'ai-magic' ? 'size-4' : 'size-3.5';
---

<span class:list={['relative block shrink-0', size, className]} aria-hidden="true">
  {
    name === 'ai-magic' ? (
      <img alt="" class="absolute inset-0 block size-full max-w-none" src="/images/icons/ai-magic.svg" />
    ) : (
      ICONS[name].map((layer) => (
        <span class:list={['absolute', layer.box]}>
          <span class:list={['absolute', layer.pad]}>
            <img alt="" class="block size-full max-w-none" src={layer.src} />
          </span>
        </span>
      ))
    )
  }
</span>
