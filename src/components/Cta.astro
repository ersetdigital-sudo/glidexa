---
import { CTA, LINKS } from '../data/site';
---

<section class="relative flex w-full flex-col items-start overflow-clip border-y border-line bg-page px-0">
  <div class="glow-top relative mx-auto flex w-full max-w-none flex-col items-center gap-10 border-x border-line px-4 py-20 sm:px-8 lg:px-16 lg:py-[124px]">
    <div class="pointer-events-none absolute top-0 left-0 h-[502px] w-full overflow-hidden mix-blend-hard-light">
      <img alt="" class="absolute top-0 left-[-0.48%] h-[110.08%] w-[106.89%] max-w-none" src="/images/bg-texture.png" />
    </div>
    <div class="relative flex w-full flex-col items-center gap-2 text-center text-text">
      <h2 class="w-full max-w-[1112px] font-mono text-[28px] leading-10 font-medium sm:text-[36px] sm:leading-[56px] lg:text-5xl lg:leading-[96px]">{CTA.title}</h2>
      <p class="font-geist text-base leading-7 sm:text-lg sm:leading-9 lg:text-2xl lg:leading-[48px] xl:-mx-12 xl:whitespace-nowrap">{CTA.subtitle}</p>
    </div>
    <a
      href={LINKS.playStore}
      target="_blank"
      rel="noopener"
      class="relative flex items-center justify-center gap-4 rounded-lg border border-azure-51 bg-white px-8 py-[15px] transition-opacity hover:opacity-90"
    >
      <span class="font-mono text-lg leading-9 tracking-[-0.16px] whitespace-nowrap text-page lg:text-2xl">{CTA.button}</span>
    </a>
  </div>
</section>
