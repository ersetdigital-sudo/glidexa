---
import { COMPANY, FOOTER_COLUMNS } from '../data/site';
---

<footer class="relative flex w-full flex-col items-start overflow-clip border-y border-line bg-page px-0">
  <div class="mx-auto flex w-full max-w-none flex-col gap-12 border-x border-b border-line px-6 pt-14 pb-12 lg:flex-row lg:items-start lg:justify-between lg:gap-0 lg:px-[max(3rem,calc((100%-1400px)/2))] lg:pt-20 lg:pb-16">
    <div class="flex flex-col items-start gap-6">
      <a href="/#home" class="flex items-center gap-3" aria-label="GlideXAVPN home">
        <img src="/images/logo.svg" alt="" width="23" height="22" class="h-[22px] w-[23px]" />
        <span class="h-[22px] font-inter text-2xl leading-[22px] font-medium tracking-[-0.15px] text-text">GLIDEXAVPN</span>
      </a>
      <div class="flex flex-col items-start gap-2 font-mono text-[15px] leading-[1.6] text-white">
        <p>{COMPANY.name}</p>
        <p>{COMPANY.pse}</p>
      </div>
    </div>

    <nav class="flex w-full flex-wrap gap-x-16 gap-y-8 lg:w-[678px] lg:flex-nowrap lg:justify-between lg:gap-0" aria-label="Footer">
      {
        FOOTER_COLUMNS.map((col) => (
          <ul class="flex flex-col items-start gap-4">
            {col.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...('icon' in link ? { target: '_blank', rel: 'noopener' } : {})}
                  class="flex items-center gap-2.5 font-mono text-[15px] leading-6 whitespace-nowrap text-white transition-colors hover:text-azure-64"
                >
                  {'icon' in link && <img src={`/images/social/${link.icon}.svg`} alt="" width="20" height="20" class="size-5 shrink-0" />}
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </nav>
  </div>

  <div class="mx-auto flex w-full max-w-none flex-col gap-2.5 border-x border-line px-6 py-8 lg:px-[max(3rem,calc((100%-1400px)/2))] lg:py-[46px]">
    <div class="flex w-full flex-col-reverse items-start gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-2.5">
      <p class="font-mono text-sm leading-6 text-text lg:text-base">{COMPANY.copyright}</p>
      <div class="flex items-center gap-6">
        <img src="/images/komdigi.png" alt="Komdigi" class="h-[50px] w-[69px] object-cover" />
        <img src="/images/pse.png" alt="PSE Terdaftar" class="h-[45px] w-32 object-cover" />
      </div>
    </div>
  </div>
</footer>
