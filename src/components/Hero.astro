---
import { HERO } from '../data/site';
import StoreBadges from './StoreBadges.astro';
import PhoneMockup from './PhoneMockup.astro';
---

<section id="home" class="relative w-full overflow-clip bg-page px-0 lg:h-[973px]">
  <div class="glow-top relative mx-auto flex w-full max-w-none flex-col items-center gap-8 border-x border-line px-4 pt-16 sm:px-8 lg:h-[973px] lg:gap-10 lg:px-16 lg:pt-[124px] lg:pb-9">
    <!-- dot texture -->
    <div class="pointer-events-none absolute top-0 left-[-1px] h-full w-full mix-blend-hard-light lg:h-[973px] lg:w-full">
      <div class="absolute inset-0 overflow-hidden">
        <img alt="" class="absolute top-[50.05%] left-0 h-[54.98%] w-[103.55%] max-w-none" src="/images/bg-texture.png" />
      </div>
    </div>

    <div class="relative flex w-full max-w-[1112px] flex-col items-center gap-4 text-center text-text">
      <h1 class="w-full text-balance font-mono text-[30px] leading-[44px] font-medium sm:text-[44px] sm:leading-[64px] lg:text-[64px] lg:leading-[96px]">
        {HERO.title}
      </h1>
      <p class="w-full font-geist text-base leading-7 sm:text-lg sm:leading-9 lg:text-xl lg:leading-[48px]">{HERO.subtitle}</p>
    </div>

    <div class="relative flex w-full flex-col items-center gap-3 sm:w-auto">
      <StoreBadges />
      <p class="font-mono text-xs leading-5 tracking-wide text-text/70 lg:text-sm">{HERO.note}</p>
    </div>

    <!-- phone: full size on desktop, scaled and cropped on smaller screens -->
    <div class="relative h-[420px] w-full overflow-hidden sm:h-[560px] lg:h-auto lg:w-auto lg:overflow-visible">
      <div class="absolute top-0 left-1/2 origin-top -translate-x-1/2 scale-[0.72] sm:scale-[0.85] lg:static lg:translate-x-0 lg:scale-100">
        <PhoneMockup />
      </div>
    </div>
  </div>
</section>
